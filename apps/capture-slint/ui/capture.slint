import { Button, CheckBox, LineEdit } from "std-widgets.slint";

component ToolbarGlyph inherits Rectangle {
    in property <string> kind;
    in property <color> glyph-color;
    width: 20px;
    height: 20px;
    background: transparent;

    if kind == "pointer": Path {
        x: 2px; y: 1px; width: 16px; height: 18px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 22;
        commands: "M 2 1 L 18 10 L 11 11 L 15 19 L 12 21 L 8 13 L 4 17 Z";
        fill: root.glyph-color; stroke: root.glyph-color; stroke-width: 1px;
    }
    if kind == "pen": Path {
        x: 1px; y: 1px; width: 18px; height: 18px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 20;
        commands: "M 3 14 L 4 17 L 7 18 L 17 8 L 12 3 Z M 11 4 L 16 9 M 3 14 L 8 9";
        fill: transparent; stroke: root.glyph-color; stroke-width: 1.8px;
    }
    if kind == "rectangle": Path {
        x: 2px; y: 2px; width: 16px; height: 16px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 20;
        commands: "M 3 3 L 17 3 L 17 17 L 3 17 Z";
        fill: transparent; stroke: root.glyph-color; stroke-width: 1.8px;
    }
    if kind == "undo": Path {
        x: 1px; y: 2px; width: 18px; height: 16px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 20;
        commands: "M 7 5 L 3 9 L 7 13 M 4 9 L 11 9 C 15 9 17 11 17 15";
        fill: transparent; stroke: root.glyph-color; stroke-width: 1.8px;
    }
    if kind == "copy": Path {
        x: 1px; y: 1px; width: 18px; height: 18px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 20;
        commands: "M 7 6 L 17 6 L 17 17 L 7 17 Z M 3 14 L 3 3 L 14 3";
        fill: transparent; stroke: root.glyph-color; stroke-width: 1.8px;
    }
    if kind == "save": Path {
        x: 1px; y: 1px; width: 18px; height: 18px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 20;
        commands: "M 3 2 L 16 2 L 18 4 L 18 18 L 2 18 L 2 2 Z M 5 2 L 5 8 L 14 8 L 14 2 M 6 12 L 14 12 L 14 17 L 6 17 Z";
        fill: transparent; stroke: root.glyph-color; stroke-width: 1.6px;
    }
    if kind == "pin": Path {
        x: 2px; y: 1px; width: 16px; height: 18px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 20;
        commands: "M 6 2 L 14 2 L 13 7 L 16 10 L 11 11 L 10 18 L 9 18 L 8 11 L 3 10 L 6 7 Z";
        fill: transparent; stroke: root.glyph-color; stroke-width: 1.6px;
    }
    if kind == "ask-ai": Path {
        x: 1px; y: 1px; width: 18px; height: 18px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 20;
        commands: "M 10 2 L 11.5 7.5 L 17 9 L 11.5 10.5 L 10 16 L 8.5 10.5 L 3 9 L 8.5 7.5 Z M 16 13 L 16.7 15.3 L 19 16 L 16.7 16.7 L 16 19 L 15.3 16.7 L 13 16 L 15.3 15.3 Z";
        fill: root.glyph-color; stroke: root.glyph-color; stroke-width: 0.8px;
    }
    if kind == "close": Path {
        x: 2px; y: 2px; width: 16px; height: 16px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 20; viewbox-height: 20;
        commands: "M 4 4 L 16 16 M 16 4 L 4 16";
        fill: transparent; stroke: root.glyph-color; stroke-width: 2px;
    }
}

component ToolbarButton inherits Rectangle {
    in property <string> icon-kind;
    in property <string> tooltip-text;
    in property <bool> selected;
    callback activated;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: root.selected ? #dbeafe : touch-area.has-hover ? #f1f5f9 : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: #93c5fd;

    touch-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        Tooltip { text: @markdown("\{root.tooltip-text}"); }
    }
    ToolbarGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.icon-kind;
        glyph-color: root.selected ? #1d4ed8 : #334155;
    }
}

export component CaptureWindow inherits Window {
    in property <bool> warmup;
    in property <image> frame-image;
    in property <float> selection-x;
    in property <float> selection-y;
    in property <float> selection-width;
    in property <float> selection-height;
    in property <bool> selecting;
    in property <bool> editing;
    in property <string> status;
    in property <string> active-tool;
    in property <string> annotation-path;
    in property <float> annotation-width;
    in property <bool> annotation-visible;
    in property <float> toolbar-x;
    in property <float> toolbar-y;
    in property <bool> toolbar-visible;
    in property <bool> toolbar-inside;
    in property <string> canvas-cursor-kind;
    in property <string> toolbar-cursor-kind;
    in property <int> status-revision;
    private property <bool> toast-visible;

    callback pointer-down(float, float);
    callback pointer-move(float, float);
    callback pointer-up(float, float);
    callback choose-tool(string);
    callback run-action(string);
    callback toolbar-pointer-down(float, float);
    callback toolbar-pointer-move(float, float);
    callback toolbar-pointer-up();

    changed status-revision => {
        if (root.status != "") {
            root.toast-visible = true;
            toast-timer.restart();
        }
    }

    toast-timer := Timer {
        interval: 2400ms;
        running: false;
        triggered() => {
            root.toast-visible = false;
            self.stop();
        }
    }

    no-frame: true;
    always-on-top: true;
    background: root.warmup ? transparent : #101318;

    Rectangle {
        visible: !root.warmup;
        background: #101318;

        Image {
            source: root.frame-image;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        Rectangle {
            background: #07101880;
            width: parent.width;
            height: parent.height;
        }

        Path {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: parent.width / 1px;
            viewbox-height: parent.height / 1px;
            commands: root.annotation-path;
            stroke: #ff3b30;
            stroke-width: root.annotation-width * 1px;
            fill: #00000000;
            clip: true;
            visible: root.annotation-visible;
        }

        Rectangle {
            x: root.selection-x * 1px;
            y: root.selection-y * 1px;
            width: root.selection-width * 1px;
            height: root.selection-height * 1px;
            background: #00000008;
            border-width: 2px;
            border-color: root.editing ? #70d6ff : #ffffff;
            visible: root.selection-width > 0 && root.selection-height > 0;
        }

        // Handles stay fixed in physical size so resizing remains discoverable
        // at every selection scale.
        for handle in [
            { x: root.selection-x * 1px - 5px, y: root.selection-y * 1px - 5px },
            { x: (root.selection-x + root.selection-width / 2) * 1px - 5px, y: root.selection-y * 1px - 5px },
            { x: (root.selection-x + root.selection-width) * 1px - 5px, y: root.selection-y * 1px - 5px },
            { x: (root.selection-x + root.selection-width) * 1px - 5px, y: (root.selection-y + root.selection-height / 2) * 1px - 5px },
            { x: (root.selection-x + root.selection-width) * 1px - 5px, y: (root.selection-y + root.selection-height) * 1px - 5px },
            { x: (root.selection-x + root.selection-width / 2) * 1px - 5px, y: (root.selection-y + root.selection-height) * 1px - 5px },
            { x: root.selection-x * 1px - 5px, y: (root.selection-y + root.selection-height) * 1px - 5px },
            { x: root.selection-x * 1px - 5px, y: (root.selection-y + root.selection-height / 2) * 1px - 5px }
        ] : Rectangle {
            x: handle.x;
            y: handle.y;
            width: 10px;
            height: 10px;
            visible: root.editing && root.active-tool == "pointer" && root.selection-width > 0 && root.selection-height > 0;
            background: #70d6ff;
            border-width: 1px;
            border-color: #0c1a23;
            border-radius: 2px;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.canvas-cursor-kind == "move" ? move :
                root.canvas-cursor-kind == "crosshair" ? crosshair :
                root.canvas-cursor-kind == "nwse-resize" ? nwse-resize :
                root.canvas-cursor-kind == "nesw-resize" ? nesw-resize :
                root.canvas-cursor-kind == "ns-resize" ? ns-resize :
                root.canvas-cursor-kind == "ew-resize" ? ew-resize : default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.pointer-down(self.mouse-x / 1px, self.mouse-y / 1px);
                }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                    root.pointer-up(self.mouse-x / 1px, self.mouse-y / 1px);
                }
                if (event.kind == PointerEventKind.move) {
                    root.pointer-move(self.mouse-x / 1px, self.mouse-y / 1px);
                }
            }
        }

        Rectangle {
            visible: root.toolbar-visible;
            x: root.toolbar-x * 1px;
            y: root.toolbar-y * 1px;
            width: 408px;
            height: 56px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #d5dce5;
            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000026;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 36px;
                height: parent.height;
                border-radius: 12px;
                background: root.toolbar-inside ? #f0f7ff : #f8fafc;
                TouchArea {
                    mouse-cursor: root.toolbar-cursor-kind == "grabbing" ? grabbing : grab;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.toolbar-pointer-down(self.mouse-x / 1px + root.toolbar-x, self.mouse-y / 1px + root.toolbar-y);
                        }
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            root.toolbar-pointer-up();
                        }
                        if (event.kind == PointerEventKind.move && self.pressed) {
                            root.toolbar-pointer-move(self.mouse-x / 1px + root.toolbar-x, self.mouse-y / 1px + root.toolbar-y);
                        }
                    }
                    Tooltip { text: @markdown("拖动工具栏"); }
                }
                for dot in [
                    { x: 13px, y: 17px }, { x: 21px, y: 17px },
                    { x: 13px, y: 25px }, { x: 21px, y: 25px },
                    { x: 13px, y: 33px }, { x: 21px, y: 33px }
                ] : Rectangle {
                    x: dot.x;
                    y: dot.y;
                    width: 3px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: #94a3b8;
                }
            }

            HorizontalLayout {
                x: 42px;
                y: 10px;
                height: 36px;
                spacing: 4px;

                ToolbarButton {
                    icon-kind: "pointer";
                    tooltip-text: "指针工具";
                    selected: root.active-tool == "pointer";
                    activated => { root.choose-tool("pointer"); }
                }
                ToolbarButton {
                    icon-kind: "pen";
                    tooltip-text: "画笔工具";
                    selected: root.active-tool == "pen";
                    activated => { root.choose-tool("pen"); }
                }
                ToolbarButton {
                    icon-kind: "rectangle";
                    tooltip-text: "矩形工具";
                    selected: root.active-tool == "rectangle";
                    activated => { root.choose-tool("rectangle"); }
                }
                ToolbarButton {
                    icon-kind: "undo";
                    tooltip-text: "撤销";
                    activated => { root.run-action("undo"); }
                }
                ToolbarButton {
                    icon-kind: "copy";
                    tooltip-text: "复制截图";
                    activated => { root.run-action("copy"); }
                }
                ToolbarButton {
                    icon-kind: "save";
                    tooltip-text: "保存截图";
                    activated => { root.run-action("save"); }
                }
                ToolbarButton {
                    icon-kind: "pin";
                    tooltip-text: "固定截图";
                    activated => { root.run-action("pin"); }
                }
                ToolbarButton {
                    icon-kind: "ask-ai";
                    tooltip-text: "询问 AI";
                    activated => { root.run-action("ask-ai"); }
                }
                ToolbarButton {
                    icon-kind: "close";
                    tooltip-text: "关闭";
                    activated => { root.run-action("cancel"); }
                }
            }
        }

        toast := Rectangle {
            visible: root.toast-visible && root.status != "";
            width: min(max(toast-text.preferred-width + 32px, 128px), 440px);
            height: 36px;
            x: root.toolbar-visible
                ? max(12px, min(parent.width - self.width - 12px, root.toolbar-x * 1px + 204px - self.width / 2))
                : (parent.width - self.width) / 2;
            y: root.toolbar-visible
                ? (root.toolbar-y * 1px >= 52px
                    ? root.toolbar-y * 1px - self.height - 8px
                    : min(parent.height - self.height - 12px, root.toolbar-y * 1px + 64px))
                : parent.height - self.height - 24px;
            border-radius: 9px;
            background: #ffffff;
            border-width: 1px;
            border-color: #d5dce5;
            drop-shadow-offset-y: 3px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000024;

            Rectangle {
                x: 12px;
                y: (parent.height - self.height) / 2;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: #3b82f6;
            }
            toast-text := Text {
                x: 27px;
                y: 0px;
                width: parent.width - 37px;
                height: parent.height;
                text: root.status;
                color: #334155;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component PinWindow inherits Window {
    in property <image> pin-image;
    callback close-requested();
    no-frame: true;
    always-on-top: true;
    background: #0b1015;
    Rectangle {
        background: #0b1015;
        Image { source: root.pin-image; width: parent.width; height: parent.height; image-fit: contain; }
        TouchArea { clicked => { root.close-requested(); } }
    }
}

export component SettingsWindow inherits Window {
    in-out property <string> shortcut;
    in-out property <string> save-directory;
    in-out property <bool> close-after-copy;
    in property <string> status;
    in property <bool> status-is-error;

    callback choose-directory();
    callback save-settings(string, string, bool);
    callback cancel();

    title: "Chaos 截图设置";
    width: 520px;
    height: 390px;
    background: #f8fafc;

    Rectangle {
        background: #f8fafc;

        Text {
            x: 24px;
            y: 20px;
            text: "Chaos 截图";
            color: #0f172a;
            font-size: 20px;
            font-weight: 600;
        }
        Text {
            x: 24px;
            y: 54px;
            text: "全局快捷键";
            color: #475569;
            font-size: 13px;
        }
        LineEdit {
            x: 24px;
            y: 76px;
            width: 472px;
            text <=> root.shortcut;
            placeholder-text: "Ctrl+Shift+S";
        }

        Text {
            x: 24px;
            y: 126px;
            text: "保存目录";
            color: #475569;
            font-size: 13px;
        }
        LineEdit {
            x: 24px;
            y: 148px;
            width: 390px;
            text <=> root.save-directory;
        }
        Button {
            x: 422px;
            y: 148px;
            width: 74px;
            height: 32px;
            text: "浏览";
            clicked => { root.choose-directory(); }
        }

        CheckBox {
            x: 24px;
            y: 211px;
            width: 472px;
            text: "复制成功后关闭截图窗口";
            checked <=> root.close-after-copy;
        }

        Text {
            x: 24px;
            y: 259px;
            width: 472px;
            height: 42px;
            visible: root.status != "";
            text: root.status;
            color: root.status-is-error ? #b91c1c : #166534;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: top;
        }

        Rectangle {
            x: 0px;
            y: 319px;
            width: parent.width;
            height: 1px;
            background: #e2e8f0;
        }
        Button {
            x: 330px;
            y: 338px;
            width: 78px;
            height: 34px;
            text: "取消";
            clicked => { root.cancel(); }
        }
        Button {
            x: 418px;
            y: 338px;
            width: 78px;
            height: 34px;
            text: "保存";
            primary: true;
            clicked => {
                root.save-settings(root.shortcut, root.save-directory, root.close-after-copy);
            }
        }
    }
}
